<!-- Shared by every Android module through lintConfig in its build.gradle. -->
<lint>
    <!--
        Media3 marks most of its surface, the service, browser and player wiring this app is
        built on included, as UnstableApi: it may change between releases. The app accepts that
        once for the whole project instead of at every call site, because media3Version is pinned
        in constants.gradle and a bump that breaks an unstable API fails to compile. This is the
        project-wide opt-in the Media3 documentation describes; it ignores no other opt-in marker.
    -->
    <issue id="UnsafeOptInUsageError">
        <ignore regexp="\(markerClass = androidx\.media3\.common\.util\.UnstableApi\.class\)" />
    </issue>
</lint>
